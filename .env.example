# SHOWDOWN · poker club — настройки. Скопируйте в .env и заполните.
# Пустое значение = значение по умолчанию.

# Порт HTTP-сервера (API + Mini App).
PORT=8000

# Токен бота от @BotFather. Пусто — бот выключен, API и Mini App работают.
BOT_TOKEN=

# Публичный HTTPS-адрес Mini App (туннель или домен). Telegram открывает Mini App только по https.
# Пример: https://showdown.example.com или https://xxxx.trycloudflare.com
WEBAPP_URL=http://localhost:8000

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot).
ADMIN_IDS=
# Админы по username (через запятую, можно с @). Удобно, если ID ещё неизвестен.
ADMIN_USERNAMES=

# PostgreSQL (docker compose, см. docker-compose.yml). Пароль задаётся один раз — до первого
# `docker compose up -d`: при создании тома pgdata он записывается в базу.
POSTGRES_PASSWORD=change-me-to-a-long-password
# Адрес БД для приложения (обязательно). Пароль — тот же, что в POSTGRES_PASSWORD
# (спецсимволы в URL кодируйте: @ → %40, : → %3A, / → %2F).
DATABASE_URL=postgres://baselounge:change-me-to-a-long-password@127.0.0.1:5432/baselounge
# Размер пула соединений с БД.
DB_POOL_MAX=10

# Папка для загруженных аватаров.
MEDIA_DIR=./data/media

# Название клуба, город и часовой пояс (сезон рейтинга = календарный месяц в этом поясе).
CLUB_NAME="BASE LOUNGE"
CLUB_CITY=Москва
CLUB_TZ=Europe/Moscow

# Режим разработки: принимает заголовок X-Dev-User без проверки подписи Telegram.
# ТОЛЬКО для локальной разработки — никогда не включайте на сервере!
DEV_MODE=false

# Сколько секунд действительна сессия Telegram (initData).
INIT_DATA_TTL=86400
